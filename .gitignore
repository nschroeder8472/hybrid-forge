__pycache__/
*.pyc
.venv/
venv/

# Never commit palace data. It is a binary index — meaningless diffs, guaranteed
# conflicts across machines, and it undermines having one authoritative copy on
# the host. The repo holds the pointer, not the store.
*.palace
palace/
.mempalace/

.env
*.local.json
.claude/

# Local env — holds the host bind address
.env

# Run state: a mutable log, not a reviewable artifact.
.hybridforge/run.db
.hybridforge/run.db-wal
.hybridforge/run.db-shm
