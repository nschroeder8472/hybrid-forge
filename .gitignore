__pycache__/
*.pyc
.venv/
venv/

# Never commit palace data. It is a binary index — meaningless diffs, guaranteed
# conflicts across machines, and it undermines having one authoritative copy on
# the host. The repo holds the pointer, not the store.
*.palace
palace/
.mempalace/

.env
*.local.json
.claude/

# Local env — holds the host bind address
.env

# Run state: a mutable log, not a reviewable artifact.
.hybridforge/run.db
.hybridforge/run.db-wal
.hybridforge/run.db-shm

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Build metadata. `pip install .` leaves both behind; the artifacts under
# build/ are a stale copy of the source and would confuse a reviewer reading
# a diff that appears to change the same file twice.
*.egg-info/
build/
dist/

# The sample project under examples/ is a fixture. A run inside it writes
# code, tickets, a database and an artifact tree, and none of that is the
# fixture — so what belongs to it is listed rather than what a run leaves
# behind. A new step that writes a new file is then ignored by default
# instead of being committed the next time somebody stages everything.
#
# Adding a file to the fixture means adding a line here. `git add -f` is the
# escape hatch while you decide.
examples/sample-project/**
!examples/sample-project/**/
!examples/sample-project/*.md
!examples/sample-project/pyproject.toml
!examples/sample-project/.hybridforge/.gitignore
!examples/sample-project/.hybridforge/config.json
!examples/sample-project/wordcount/__init__.py
!examples/sample-project/wordcount/counter.py
!examples/sample-project/tests/__init__.py
!examples/sample-project/tests/counter_test.py
!examples/sample-project/plugin/pyproject.toml
!examples/sample-project/plugin/histogram/__init__.py
!examples/sample-project/plugin/histogram/bars.py
!examples/sample-project/plugin/tests/__init__.py
!examples/sample-project/plugin/tests/bars_test.py
