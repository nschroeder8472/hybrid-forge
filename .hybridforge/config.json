{
  "room": "",
  "models": {
    "nemotron": {
      "kind": "llamacpp",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "nemotron-3-nano",
      "contextWindow": 131072,
      "maxOutputTokens": 32768
    },
    "qwen": {
      "kind": "llamacpp",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "qwen3.8",
      "contextWindow": 131072,
      "maxOutputTokens": 16384
    },
    "claude": {
      "kind": "claude-cli",
      "model": "opus"
    }
  },
  "roles": {
    "planner": "nemotron",
    "executor": "qwen",
    "tester": "qwen",
    "reviewer": "nemotron"
  },
  "commands": {
    "lint": { ".py": "python -m flake8 .", ".html": "skip" },
    "typecheck": { ".py": "skip", ".html": "skip" },
    "test": "python -m unittest discover tests"
  },
  "neverDelegate": [],
  "memory": {
    "command": [
      "docker", "run", "--rm", "-i",
      "-v", "mempalace-data:/data",
      "ghcr.io/mempalace/mempalace:latest",
      "mcp", "--palace", "/data/palace"
    ],
    "room": "",
    "arguments": { "wing": "hybrid-forge" },
    "writeTool": "mempalace_add_drawer",
    "writeArguments": { "room": "decisions", "added_by": "hybrid-forge-daemon" },
    "write": true,
    "dryRun": true,
    "timeout": 120
  },
  "loop": {
    "maxAttempts": 3,
    "autoCommit": false,
    "stopOnBlocked": false,
    "pollSeconds": 2.0,
    "maxRuntimeSeconds": 0
  },
  "ui": {
    "host": "127.0.0.1",
    "port": 8799,
    "enabled": true
  }
}
