{
  "room": "gimp-sprites",
  "workspaces": [
    {
      "root": ".",
      "commands": {
        "lint": { ".py": "python -m flake8 ." },
        "typecheck": { ".py": "skip" },
        "test": { ".py": "python -m unittest discover -s tests -p \"*_test.py\" -t ." },
        "capture": { ".py": "python tools/capture.py" }
      }
    }
  ],
  "neverDelegate": [],
  "memory": { "url": "", "room": "" },
  "loop": {
    "maxAttempts": 4,
    "retryCycles": 1,
    "autoCommit": false,
    "viewRole": "reviewer",
    "viewModel": "claude",
    "exclusiveGpu": []
  }
}
