{
  "room": "sprite-sheets",
  "workspaces": [
    {
      "root": ".",
      "commands": {
        "lint": {
          ".py": "python -m flake8 ."
        },
        "typecheck": {
          ".py": "skip"
        },
        "test": {
          ".py": "python -m unittest discover -s tests -p \"*_test.py\" -t ."
        }
      }
    },
    {
      "root": "art",
      "commands": {
        "lint": {
          ".py": "python -m flake8 ."
        },
        "typecheck": {
          ".py": "skip"
        },
        "test": {
          ".py": "blender -b --factory-startup --python-exit-code 1 --python tests/run_checks.py"
        },
        "capture": {
          ".py": "blender -b --factory-startup --python-exit-code 1 --python tools/capture.py"
        }
      }
    }
  ],
  "neverDelegate": [],
  "memory": {
    "url": "",
    "room": ""
  },
  "loop": {
    "maxAttempts": 4,
    "retryCycles": 1,
    "autoCommit": false,
    "viewRole": "reviewer",
    "viewModel": "claude"
  }
}