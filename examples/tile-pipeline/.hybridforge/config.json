{
  "room": "tile-pipeline",
  "imageModels": {
    "flux2": {
      "kind": "comfyui",
      "workflows": {
        "generate": ".hybridforge/comfy/flux2-turbo.json"
      },
      "bind": {
        "prompt": [
          "6",
          "text"
        ],
        "seed": [
          "25",
          "noise_seed"
        ],
        "width": [
          "47",
          "width"
        ],
        "height": [
          "47",
          "height"
        ]
      },
      "promptGuide": "Flux.2 dev with the turbo LoRA. It follows a prompt closely and draws even textures well. For a tile: ask for a top-down texture that fills the whole frame edge to edge, evenly, with no border, no frame, no single large object, no vignette and flat even lighting. The pixel-art look comes afterwards from the formatter, so do not ask for pixel art."
    }
  },
  "workspaces": [
    {
      "root": ".",
      "commands": {
        "lint": {
          ".py": "python -m flake8 ."
        },
        "typecheck": {
          ".py": "skip"
        },
        "test": {
          ".py": "python -m unittest discover -s tests -p \"*_test.py\" -t ."
        },
        "format": {
          ".png": "gimp-console-3 -i -n --quit --batch-interpreter=python-fu-eval -b \"import sys; sys.path.insert(0, 'tools/gimp'); exec(open('tools/gimp/finish_tile.py').read())\""
        }
      }
    },
    {
      "root": "art",
      "commands": {
        "lint": {
          ".py": "python -m flake8 ."
        },
        "typecheck": {
          ".py": "skip"
        },
        "test": {
          ".py": "blender -b --factory-startup --python-exit-code 1 --python tests/run_checks.py"
        },
        "capture": {
          ".py": "blender -b --factory-startup --python-exit-code 1 --python tools/capture.py"
        }
      }
    }
  ],
  "neverDelegate": [],
  "memory": {
    "url": "",
    "room": ""
  },
  "loop": {
    "maxAttempts": 4,
    "retryCycles": 1,
    "autoCommit": false,
    "viewRole": "reviewer",
    "viewModel": "claude",
    "imageModel": "flux2",
    "exclusiveGpu": [
      "image"
    ]
  }
}