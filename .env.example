# Copy to .env and fill in. docker compose interpolates these at up time.
#
# The IP of the interface you want llama-server reachable on — the private
# address your other machines use to reach this host. `ip -4 addr` lists them.
#
# This is a bind address, not a connection address, and llama-server is
# UNAUTHENTICATED. Setting it to 0.0.0.0 publishes an open inference endpoint to
# every network this host is attached to. Pick the narrowest interface that
# still reaches the machines you code from.
#
# If the GPU and the repo are on the same machine, that is 127.0.0.1 — nothing
# has to leave the box.
BIND_ADDR=192.168.1.10
LLAMA_PORT=8080

# Where the .gguf files live on this host, mounted read-only at /models. The
# paths in the preset are container paths, so `modelPath` in config.json should
# read /models/<file>.gguf rather than the host path.
MODELS_DIR=/srv/models

# The directory holding the generated preset — .hybridforge/models/ of the
# project whose config it was written from. Mounted read-only at /presets.
PRESET_DIR=/srv/forge/.hybridforge/models

# How many checkpoints may be resident at once. Leave at 1 unless every model
# in the preset fits in VRAM together: the router keeps the previous role's
# checkpoint loaded and the next role's child server exits trying to allocate.
LLAMA_MODELS_MAX=1

# No MemPalace port here: by default it speaks MCP over stdio and binds
# nothing — the daemon starts it as a child process. See `memory.command` in
# docker-compose.yml.
#
# A palace on a different machine uses `mempalace serve` instead, which binds
# port 8765 and requires a bearer token on any non-loopback address. That token
# belongs in the environment, not in a committed config.json:
# MEMPALACE_TOKEN=
