# Copy to .env and fill in. docker compose interpolates these at up time.
#
# Resolve your Tailscale address with:
#   tailscale ip -4 | head -n1
#
# This is a bind address, not a connection address. Setting it to 0.0.0.0
# publishes an unauthenticated inference endpoint to your entire LAN.
TS_IP=100.x.y.z

# How long weights stay resident in VRAM after the last request.
OLLAMA_KEEP_ALIVE=30m

# MemPalace MCP port.
PALACE_PORT=8787
