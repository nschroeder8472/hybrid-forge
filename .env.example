# Copy to .env and fill in. docker compose interpolates these at up time.
#
# The IP of the interface you want these services reachable on — the private
# address your other machines use to reach this host. `ip -4 addr` lists them.
#
# This is a bind address, not a connection address, and both services below are
# UNAUTHENTICATED. Setting it to 0.0.0.0 publishes an open inference endpoint
# and an open memory store to every network this host is attached to. Pick the
# narrowest interface that still reaches the machines you code from.
BIND_ADDR=192.168.1.10

# How long weights stay resident in VRAM after the last request.
OLLAMA_KEEP_ALIVE=30m

# MemPalace MCP port.
PALACE_PORT=8787
